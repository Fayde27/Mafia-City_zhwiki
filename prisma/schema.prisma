generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  summary     String?
  coverImage          String?
  coverImagePosition  String?  @default("50% 50%")
  thumbnailPosition   String?  @default("50% 50%")
  categoryId          String
  tags        String?
  isPublished Boolean  @default(false)
  isPinned    Boolean  @default(false)
  badges      String?
  sortOrder   Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  banner    String?
  type      String   @default("info")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  icon        String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  characters  Character[]
}

model CharacterFilterOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  avatar         String?
  avatarPosition String?
  banner         String?
  bannerPosition String?
  rarity         String            @default("金")
  traits         String?
  troopType      String?
  acquisition    String?
  story          String?
  attributes     String?
  skills         String?
  awakenHero     Boolean?          @default(false)
  haojieEquip    String?
  characterType  String            @default("hero")
  categoryId     String
  sortOrder      Int               @default(0)
  isPublished    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  category       CharacterCategory @relation(fields: [categoryId], references: [id])
  skins          CharacterSkin[]
  skinBonds      CharacterSkinBond[]
  teamComps      CharacterTeamComp[]
  bloodBonds     CharacterBloodBond[]
  equipments     CharacterEquipment[]
  articles       CharacterArticle[]
}

model CharacterSkin {
  id          String    @id @default(cuid())
  characterId String
  name        String
  art         String?
  icon        String?
  bonuses     String?
  acquisition String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterSkinBond {
  id          String    @id @default(cuid())
  characterId String
  name        String
  skinIds     String    @default("[]")
  bonuses     String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterTeamComp {
  id          String                    @id @default(cuid())
  characterId String
  name        String
  reason      String?
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  character   Character                 @relation(fields: [characterId], references: [id], onDelete: Cascade)
  members     CharacterTeamCompMember[]
}

model CharacterTeamCompMember {
  id         String            @id @default(cuid())
  teamCompId String
  memberId   String
  sortOrder  Int               @default(0)
  teamComp   CharacterTeamComp @relation(fields: [teamCompId], references: [id], onDelete: Cascade)
}

model CharacterBloodBond {
  id            String                     @id @default(cuid())
  characterId   String
  requiredStars Int                        @default(0)
  bonuses       String?
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  character     Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  members       CharacterBloodBondMember[]
}

model CharacterBloodBondMember {
  id          String             @id @default(cuid())
  bloodBondId String
  memberId    String
  sortOrder   Int                @default(0)
  bloodBond   CharacterBloodBond @relation(fields: [bloodBondId], references: [id], onDelete: Cascade)
}

model CharacterEquipment {
  id          String    @id @default(cuid())
  characterId String
  equipmentId String
  sortOrder   Int       @default(0)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterArticle {
  id          String    @id @default(cuid())
  characterId String
  articleId   String
  sortOrder   Int       @default(0)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model BuildingCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  buildings   Building[]
}

model BuildingFilterOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Building {
  id           String          @id @default(cuid())
  buildingType String          @default("inner") // inner | season | event
  name        String
  slug        String           @unique
  icon            String?
  iconPosition    String?          @default("50% 50%")
  image           String?
  imagePosition   String?          @default("50% 50%")
  summary         String?
  rarity          Int              @default(3)
  type            String?
  function        String?
  unlockCondition String?
  affiliation     String?          // 賽季/賽事建築的「所屬賽季/賽事」文本
  level           Int              @default(1)
  maxLevel        Int              @default(10)
  cost            String?
  production      String?
  description     String?
  details         String?
  upgradeInfo     String?
  upgradeLevels   String?
  categoryId      String?
  sortOrder       Int              @default(0)
  isFeatured      Boolean          @default(false)
  isPublished     Boolean          @default(false)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        BuildingCategory? @relation(fields: [categoryId], references: [id])
}

model EquipmentCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  icon        String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]
}

model EquipmentFilterOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  summary       String?
  equipType     String             @default("leader") // haojie_weapon | haojie_warbadge | leader | hero
  icon          String?
  iconPosition  String?            @default("50% 50%")
  image         String?
  imagePosition String?            @default("50% 50%")
  rarity        Int                @default(3) // 品質：1白 2綠 3藍 4紫 5橙 6金
  type          String? // 種類（武器種類/戰徽種類）
  slot          String? // 部位（首領/英雄）
  attrBias      String? // 屬性偏向（首領）
  buffs         String? // 豪傑武器/戰徽：分類→細分 JSON
  setId         String? // 套裝關聯（首領/英雄）
  attack        Int                @default(0)
  defense       Int                @default(0)
  hp            Int                @default(0)
  speed         Int                @default(0)
  skill         String?
  description   String?
  stats         String? // 裝備屬性多行文本（首領/英雄）
  enhancement   String?
  acquisition   String?
  categoryId    String?
  sortOrder     Int                @default(0)
  isFeatured    Boolean            @default(false)
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  category      EquipmentCategory? @relation(fields: [categoryId], references: [id])
  set           EquipmentSet?      @relation(fields: [setId], references: [id])
}

model EquipmentSet {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  equipType     String      @default("hero") // leader | hero
  icon          String?
  iconPosition  String?     @default("50% 50%")
  setBonus      String? // 套裝屬性加成
  description   String?
  sortOrder     Int         @default(0)
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pieces        Equipment[]
}

model ItemCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
}

model ItemFilterOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  summary       String?
  icon          String?
  iconPosition  String?      @default("50% 50%")
  image         String?
  imagePosition String?      @default("50% 50%")
  rarity        Int          @default(3)
  type          String?
  quality       String?
  stackable     Boolean      @default(true)
  effect        String?
  description   String?
  usage         String?
  recipe        String?
  source        String?
  categoryId    String
  sortOrder     Int          @default(0)
  isFeatured    Boolean      @default(false)
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  category      ItemCategory @relation(fields: [categoryId], references: [id])
}

model TroopCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  troops      Troop[]
}

model TroopFilterOption {
  id        String   @id @default(cuid())
  type      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Troop {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  summary       String?
  icon          String?
  iconPosition  String?       @default("50% 50%")
  image         String?
  imagePosition String?       @default("50% 50%")
  troopType     String?
  rarity        Int           @default(3)
  combatPower   Int           @default(0)
  attack        Int           @default(0)
  defense       Int           @default(0)
  hp            Int           @default(0)
  speed         Int           @default(0)
  load          Int           @default(0)
  attackRange   Int           @default(0)
  cashCost      Int           @default(0)
  talent        String?
  counter       String?
  weakness      String?
  description   String?
  stats         String?
  skills        String?
  training      String?
  type          String?
  categoryId    String
  sortOrder     Int           @default(0)
  isFeatured    Boolean       @default(false)
  isPublished   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      TroopCategory @relation(fields: [categoryId], references: [id])
}

model SidebarNav {
  id          String   @id @default(cuid())
  section     String   // 所属分组：quick-entry 或 shortcut
  label       String   // 显示名称
  icon        String?  // 图标
  href        String   // 跳转链接
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
